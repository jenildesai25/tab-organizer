{
  "manifest_version": 3,
  "name": "Tab Organizer",
  "version": "0.1.2",
  "description": "Files tabs into groups from the site, the title, and rules you write in plain language.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": ["http://127.0.0.1:11434/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Organizer",
    "default_popup": "popup/popup.html"
  }
}
